{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "finance-interview-mcp",
      "version": "0.1.0",
      "title": "Finance Interview Prep"
    },
    "tools": [
      {
        "name": "search_questions",
        "title": "Search interview questions",
        "description": "Search the finance interview question bank by keyword and/or category (valuation, dcf, ma, lbo, accounting, ts, fit, etc.). Returns matching questions with their full model answers.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Free-text keyword matched against the question text and model answer. Use empty string to match all.",
              "default": ""
            },
            "category": {
              "type": "string",
              "description": "Optional category filter (e.g. 'valuation', 'dcf', 'ma', 'lbo', 'accounting', 'ts', 'fit')."
            },
            "difficulty": {
              "type": "string",
              "description": "Optional difficulty filter (e.g. 'basique', 'intermédiaire', 'avancé')."
            },
            "limit": {
              "type": "integer",
              "description": "Max number of results. Use 20 by default.",
              "default": 20
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_concepts",
        "title": "List finance concepts",
        "description": "List the finance concept sheets (EV/Equity, DCF, WACC, LBO mechanics, accretion/dilution, etc.). Optionally filter by category or fetch a specific concept by id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "If provided, return only the concept with this id (e.g. 'c1')."
            },
            "category": {
              "type": "string",
              "description": "Optional category filter."
            },
            "includeDeepDive": {
              "type": "boolean",
              "description": "Include the long-form explanation and tables. Set to false for a compact list.",
              "default": false
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "search_acronyms",
        "title": "Search finance acronyms",
        "description": "Search the finance acronym glossary by abbreviation, English name, or French translation. Returns matching entries with their section.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Keyword to match against abbreviation, English label, or French definition. Empty returns all.",
              "default": ""
            },
            "limit": {
              "type": "integer",
              "description": "Max number of results.",
              "default": 50
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_ma_deals",
        "title": "List M&A deals",
        "description": "List recent M&A / LBO / IPO / restructuring deals covered in the app, with parties, banks, and interview angles. Filter by keyword, type, or sector.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Free-text keyword filter.",
              "default": ""
            },
            "type": {
              "type": "string",
              "description": "Deal type filter (e.g. 'M&A', 'IPO', 'LBO', 'Carve-out', 'Restructuring', 'OPA', 'Cessions', 'Tendance')."
            },
            "sectorId": {
              "type": "string",
              "description": "Sector id filter."
            },
            "limit": {
              "type": "integer",
              "default": 20
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_banks",
        "title": "List investment bank profiles",
        "description": "List the investment bank profiles covered in the app (bulge brackets, elite boutiques, French banks, etc.), with divisions, culture, and interview tips.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "If provided, return only the bank with this id (e.g. 'rothschild-co')."
            },
            "category": {
              "type": "string",
              "description": "Category id filter (e.g. 'elite-boutique', 'bulge-bracket')."
            },
            "query": {
              "type": "string",
              "description": "Free-text keyword filter.",
              "default": ""
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
